$as_echo "## ---------------------------------------- ##
## GnuCOBOL 3.2 test suite: GnuCOBOL Tests. ##
## ---------------------------------------- ##"
{
  $as_echo "## ---------------------------------------- ##
## GnuCOBOL 3.2 test suite: GnuCOBOL Tests. ##
